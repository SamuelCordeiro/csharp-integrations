{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowCredentials": false
  },
  "BearerToken": {
    "Issuer": "csharp-integrations-api",
    "Audience": "csharp-integrations-client",
    "AccessTokenMinutes": 5,
    "RefreshTokenDays": 7
  }
}
