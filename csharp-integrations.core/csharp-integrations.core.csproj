        <RootNamespace>csharp_integrations.core</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
      <UserSecretsId>efdabe79-e0c0-4cea-a487-d7ec84928757</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.8.6" />
