      <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
      <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Auth\SAML\ClaimsTransform\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Auth\SAML\ClaimsTransform\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Auth\SAML\ClaimsTransform\**" />
    </ItemGroup>

</Project>
