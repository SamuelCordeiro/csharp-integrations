<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>csharp_integrations.core</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.19.2" />
      <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.19.2" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
      <PackageReference Include="OllamaSharp" Version="5.4.8" ExcludeAssets="analyzers" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Auth\SAML\ClaimsTransform\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Auth\SAML\ClaimsTransform\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Auth\SAML\ClaimsTransform\**" />
    </ItemGroup>

</Project>
